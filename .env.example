# SUTRA Vision Engine - Environment Configuration

# System Identity
SUTRA_DEVICE_ID=ai-device-01
SUTRA_EXPERIMENT_ID=DEMO-WETLAB-01

# Ingestion Settings
# 0 for default USB webcam, or path to MP4/AVI file, or RTSP stream
SUTRA_VIDEO_SOURCE=0
SUTRA_TARGET_FPS=15.0
SUTRA_FRAME_WIDTH=640
SUTRA_FRAME_HEIGHT=480
SUTRA_LOOP_VIDEO=true

# Detection & Pose Backends
SUTRA_MODEL_PATH=models/yolo_sutra.onnx
SUTRA_DETECTION_CONF_THRESHOLD=0.45
SUTRA_POSE_BACKEND=kinematic

# Protocol & Calibration
SUTRA_PROTOCOL_PATH=protocols/demo_wetlab.yaml
SUTRA_CALIBRATION_PATH=data/calibration.json

# Storage & Telemetry
SUTRA_STORAGE_LOG_PATH=data/events/telemetry_events.jsonl
SUTRA_STORAGE_EXPORT_PATH=data/events/telemetry_export.json

# Communication & Publisher (Connects directly to SUTRA Backend)
SUTRA_ENABLE_HTTP_PUBLISHER=true
SUTRA_PUBLISHER_URL=http://127.0.0.1:8000/api/v1/telemetry/events
